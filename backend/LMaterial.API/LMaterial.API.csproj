  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LMaterial.Infrastructure\LMaterial.Infrastructure.csproj" />
    <ProjectReference Include="..\LMaterial.Application\LMaterial.Application.csproj" />
  </ItemGroup>

